{
  "mcpServers": {
    "headroom": {
      "command": "uvx",
      "args": ["--from", "headroom-ai[mcp]==0.41.0", "headroom", "mcp", "serve"]
    },
    "filesystem": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-filesystem@1.0.0", "."]
    },
    "fetch": {
      "command": "uvx",
      "args": ["mcp-server-fetch==2026.10.10"]
    },
    "context7": {
      "command": "npx",
      "args": ["-y", "@upstash/context7-mcp@4.4.2"]
    },
    "playwright": {
      "command": "npx",
      "args": ["@playwright/mcp@0.0.83"]
    }
  }
}
